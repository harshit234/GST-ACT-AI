# ═══════════════════════════════════════════════════════════════
# GST ACT AI — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Server
PORT=5000

# Google Gemini AI (for extraction + fallback OCR)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Vision (primary OCR engine)
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# OpenRouter (HSN code lookup via Gemini Flash)
OPENROUTERAPI_KEY=your_openrouter_api_key_here

# Twilio (WhatsApp messaging + OTP SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# TWILIO_SMS_NUMBER=+1xxxxxxxxxx        # Optional: enables real OTP SMS

# Supabase (PostgreSQL database + storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Dashboard (optional: shown in WhatsApp messages)
# DASHBOARD_URL=https://your-domain.com/dashboard
